# VARUNA — copy to .env. Every value here has a working default in
# backend/app/config.py; this file exists to make the knobs visible.

# --- database / cache --------------------------------------------------------
POSTGRES_USER=varuna
POSTGRES_PASSWORD=varuna
POSTGRES_DB=varuna
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000

# --- runtime -----------------------------------------------------------------
VARUNA_ENV=dev
VARUNA_LOG_LEVEL=INFO

# --- §5.1 reverse-drift solver ----------------------------------------------
VARUNA_WINDAGE_ALPHA=0.033          # tunable range [0.020, 0.040]
VARUNA_THETA_DEV_DEG=0.0            # tunable range [-20, +20], Coriolis veer
VARUNA_DRIFT_DT_S=300
VARUNA_DRIFT_HORIZON_H=12
VARUNA_DRIFT_N_PARTICLES=5000
VARUNA_K_H_M2S=10.0
VARUNA_DRIFT_SNAPSHOT_INTERVAL_MIN=30
VARUNA_DRIFT_SEED=42

# --- §5.2 detection wind gate ------------------------------------------------
VARUNA_WIND_GATE_MIN_MS=3.0
VARUNA_WIND_GATE_MAX_MS=12.0

# --- §5.3 attribution channels ----------------------------------------------
VARUNA_E1_CORRIDOR_SIGMA_M=500.0
VARUNA_E2_SIGMA_THETA_DEG=25.0
VARUNA_E3_TAU_MEDIAN_MIN=90.0
VARUNA_E3_TAU_SIGMA=0.9
VARUNA_E4_GAP_COEFFICIENT=0.4
VARUNA_E4_GAP_REFERENCE_MIN=30.0
VARUNA_E4_GAP_CAP=3.0

# --- §5.4 fusion -------------------------------------------------------------
VARUNA_FUSION_W1=1.0
VARUNA_FUSION_W2=0.7
VARUNA_FUSION_W3=0.5
VARUNA_PRIOR_TANKER=3.0
VARUNA_PRIOR_BULK_CARGO=1.5
VARUNA_PRIOR_FISHING=1.0
VARUNA_PRIOR_OTHER=1.0
VARUNA_PRIOR_PASSENGER=0.5
VARUNA_PRIOR_HISTORY_COEFFICIENT=0.5

# The §5.4 decision bands (ln 10 / ln 100) are NOT here and never will be.
# They are a safety property, not a tunable (§9), and live as Final constants in
# backend/app/attribution/fusion.py so no environment can move them.

# --- frontend (runs natively on the host) ------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE=ws://localhost:8000/api/v1/ws
